{
  "name": "@lightspeed/bots",
  "private": true,
  "type": "module",
  "description": "Bots control plane: durable event routers that own managed sessions.",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./workflows": "./src/workflows/index.ts",
    "./schedules": "./src/schedules.ts",
    "./webhooks": "./src/webhooks.ts",
    "./config": "./src/config.ts",
    "./rendering": "./src/rendering.ts",
    "./events": "./src/events.ts",
    "./admission": "./src/admission.ts",
    "./credentials": "./src/credentials.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "BOTS_TEMPORAL_INTEGRATION=1 vitest run test/bots.integration.test.ts"
  },
  "dependencies": {
    "@lightspeed/agent-client": "*",
    "@lightspeed/platform-db": "*",
    "@noble/hashes": "2.2.0",
    "@temporalio/activity": "1.21.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/common": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "drizzle-orm": "^0.45.0",
    "cel-js": "^0.8.2",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@temporalio/testing": "1.21.1",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
