---
import Head from '@astrojs/starlight/components/Head.astro';
import headingFont from '../assets/fonts/merriweather-latin.woff2?url';
import bodyFont from '../assets/fonts/merriweather-sans-latin.woff2?url';
import labelFont from '../assets/fonts/league-gothic-latin.woff2?url';
const route = Astro.locals.starlightRoute;
if (route.entry.id === '404') {
  // The error document is served at arbitrary missing URLs, not /404/.
  route.head = route.head.filter(({ attrs }) => attrs?.rel !== 'canonical');
  route.head.push({ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } });
}
---
{/* Start the fonts used on every page before stylesheets discover them. These
    imports resolve to the same asset URLs used by the CSS in dev and builds. */}
{[bodyFont, headingFont, labelFont].map((href) => (
  <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
))}
<Head />
